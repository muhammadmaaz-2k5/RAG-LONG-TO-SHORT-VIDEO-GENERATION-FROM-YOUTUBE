# Database - PostgreSQL with pgvector (Neon Serverless or Local)
# Note: Use asyncpg driver prefix for SQLAlchemy async engine
DATABASE_URL=postgresql+asyncpg://user:password@ep-sample-pooler.neon.tech/neondb?ssl=require

# Groq LLM API
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Embedding Model Configuration
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384

# Frontend / CORS
FRONTEND_URL=http://localhost:3000

# Cloudinary Media Storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
